@{
    ViewData["Title"] = "Performance testing";

    var target = ViewBag.TargetRows as int? ?? 0;
    var currentSongs = ViewBag.CurrentSongs as int? ?? 0;

    var seedMs = TempData["SeedMs"] as int?;
    var seedRows = TempData["SeedRows"] as int?;
    var seedError = TempData["SeedError"] as string;

    Func<int, string> fmt = n => n.ToString("N0");
    Func<double, string> fmtD = n => n.ToString("N0");
}

<h1>Performance testing</h1>

<div class="alert alert-info">
    <strong>Target:</strong> @fmt(target) records.
    Songs currently: <strong>@fmt(currentSongs)</strong>
</div>

@if (seedError is not null)
{
    <div class="alert alert-warning">@seedError</div>
}
else if (seedMs is not null && seedRows is not null)
{
    var ms = (int)seedMs;
    var rows = (int)seedRows;
    var rps = ms == 0 ? 0 : rows * 1000.0 / ms;
    <div class="alert alert-success">
        Inserted @fmt(rows) songs in @fmt(ms) ms (@fmtD(rps) rows/sec).
    </div>
}

@if (currentSongs < target)
{
    var remaining = target - currentSongs;
    <form asp-action="Seed" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-warning"
                onclick='return confirm("This generates @fmt(remaining) songs. Can take tens of seconds. Continue?");'>
            Generate @fmt(remaining) records
        </button>
    </form>
}
else
{
    <div class="alert alert-secondary">
        Target reached. Test filtering and pagination on the Songs page.
    </div>
}

<p class="mt-3">
    <a asp-controller="Song" asp-action="Index" class="btn btn-outline-primary">Go to Songs</a>
</p>
