@model IEnumerable<MusicApp.Web.Models.Song>

@{
    ViewData["Title"] = "Songs";

    var singerName = ViewData["SingerName"] as string;
    var categoryId = ViewData["CategoryId"] as int?;
    var categories = ViewData["Categories"] as SelectList;
}

<h1>Songs</h1>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">Singer name</label>
        <input name="singerName" value="@singerName" class="form-control" placeholder="Filter by singer" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Category</label>
        <select name="categoryId" asp-items="categories" class="form-select">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.First().Title)</th>
            <th>@Html.DisplayNameFor(m => m.First().Singer)</th>
            <th>@Html.DisplayNameFor(m => m.First().Category)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(_ => item.Title)</td>
                <td>@Html.DisplayFor(_ => item.Singer.Name)</td>
                <td>@Html.DisplayFor(_ => item.Category.Name)</td>
            </tr>
        }
    </tbody>
</table>
