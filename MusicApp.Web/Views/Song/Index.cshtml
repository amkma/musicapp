@model PaginatedList<MusicApp.Web.Models.Song>

@using MusicApp.Web.Models
@using MusicApp.Web.Helpers

@{
    ViewData["Title"] = "Songs";

    var singerName = ViewData["SingerName"] as string;
    var categoryId = ViewData["CategoryId"] as int?;
    var categories = ViewData["Categories"] as SelectList;
    var singersOnPage = ViewData["SingersOnPage"] as IEnumerable<Singer>;
    var lastId = ViewData["LastId"] as int? ?? 0;
    var firstId = ViewData["FirstId"] as int? ?? 0;

    Func<int, string> fmt = n => n.ToString("N0");
}

<h1>Songs</h1>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">Singer name</label>
        <input name="singerName" value="@singerName" class="form-control" placeholder="Filter by singer" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Category</label>
        <select name="categoryId" asp-items="categories" class="form-select">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<p class="text-muted small">Total @fmt(Model.TotalCount) songs @fmt(Model.TotalPages) pages of @Model.PageSize. Page @(Model.PageIndex) (cached count, refreshed every 5 min).</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Items.First().Title)</th>
            <th>@Html.DisplayNameFor(m => m.Items.First().Singer)</th>
            <th>@Html.DisplayNameFor(m => m.Items.First().Category)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@Html.DisplayFor(_ => item.Title)</td>
                <td>
                    @* ponytail: pure Bootstrap modal trigger via data-bs-*, zero custom JS *@
                    <button type="button" class="btn btn-link p-0 align-baseline"
                            data-bs-toggle="modal" data-bs-target="#singerModal@(item.Singer.Id)">
                        @item.Singer.Name
                    </button>
                </td>
                <td>@Html.DisplayFor(_ => item.Category.Name)</td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Songs pagination">
    <ul class="pagination">
        @* ponytail: keyset (seek) for Prev/Next; OFFSET for direct page-number jumps *@
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-seek="prev"
                   asp-route-firstId="@firstId" asp-route-page="@(Model.PageIndex)"
                   asp-route-singerName="@singerName" asp-route-categoryId="@categoryId">Previous</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">Previous</span></li>
        }

        @for (int i = 1; i <= Model.TotalPages && i <= 10; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i"
                   asp-route-singerName="@singerName" asp-route-categoryId="@categoryId">@i</a>
            </li>
        }
        @if (Model.TotalPages > 10)
        {
            <li class="page-item disabled"><span class="page-link">...</span></li>
            if (Model.PageIndex > 10 && Model.PageIndex < Model.TotalPages)
            {
                <li class="page-item active"><span class="page-link">@Model.PageIndex</span></li>
            }
            <li class="page-item @(Model.TotalPages == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages"
                   asp-route-singerName="@singerName" asp-route-categoryId="@categoryId">@Model.TotalPages</a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-seek="next"
                   asp-route-lastId="@lastId" asp-route-page="@(Model.PageIndex)"
                   asp-route-singerName="@singerName" asp-route-categoryId="@categoryId">Next</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">Next</span></li>
        }
    </ul>
</nav>

@* Modal instances for each distinct singer on the current page *@
@foreach (var s in singersOnPage ?? Enumerable.Empty<Singer>())
{
    @await Html.PartialAsync("_SingerModal", s)
}
