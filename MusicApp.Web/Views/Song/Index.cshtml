@model PaginatedList<MusicApp.Web.Models.Song>

@{
    ViewData["Title"] = "Songs";

    var singerName = ViewData["SingerName"] as string;
    var categoryId = ViewData["CategoryId"] as int?;
    var categories = ViewData["Categories"] as SelectList;
}

<h1>Songs</h1>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">Singer name</label>
        <input name="singerName" value="@singerName" class="form-control" placeholder="Filter by singer" />
    </div>
    <div class="col-md-4">
        <label class="form-label">Category</label>
        <select name="categoryId" asp-items="categories" class="form-select">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Items.First().Title)</th>
            <th>@Html.DisplayNameFor(m => m.Items.First().Singer)</th>
            <th>@Html.DisplayNameFor(m => m.Items.First().Category)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@Html.DisplayFor(_ => item.Title)</td>
                <td>@Html.DisplayFor(_ => item.Singer.Name)</td>
                <td>@Html.DisplayFor(_ => item.Category.Name)</td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Songs pagination">
    <ul class="pagination">
        @if (Model.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)" asp-route-singerName="@singerName" asp-route-categoryId="@categoryId">Previous</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">Previous</span></li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-singerName="@singerName" asp-route-categoryId="@categoryId">@i</a>
            </li>
        }

        @if (Model.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)" asp-route-singerName="@singerName" asp-route-categoryId="@categoryId">Next</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link">Next</span></li>
        }
    </ul>
</nav>
