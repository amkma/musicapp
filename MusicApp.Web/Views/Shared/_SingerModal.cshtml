@model MusicApp.Web.Models.Singer
@{
    var modalId = $"singerModal{Model.Id}";
}
<div class="modal fade" id="@modalId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Model.Name</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid mb-2" alt="@Model.Name" />
                }
                <p class="mb-0"><strong>Singer</strong></p>
                <p class="text-muted small mb-0">ID @Model.Id</p>
            </div>
        </div>
    </div>
</div>
